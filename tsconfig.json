{
  "compilerOptions": {
    "target": "ES2022",

    "module": "nodenext",

    "moduleResolution": "nodenext",

    "rootDir": "./src",

    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "typeRoots": ["./node_modules/@types"],

    "types": ["node"]
  },

  "include": ["src/**/*"]
}
